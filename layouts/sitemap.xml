{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Data.Pages }}
    {{- if and (ne .Layout "search") (not .Params.robotsNoIndex) (ne .Kind "404") (ne .Kind "taxonomy") (ne .Kind "term") }}
  <url>
    <loc>{{ .Permalink }}</loc>
      {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
      {{- end }}
  </url>
    {{- end }}
  {{- end }}
  {{- range (slice "tools/" "tools/pomodoro/" "tools/breathing/" "tools/meditation/" "tools/fasting/" "tools/zenkaku-hankaku/" "tools/typewriter/" "tools/cut/") }}
  <url>
    <loc>{{ . | absURL }}</loc>
  </url>
  {{- end }}
</urlset>
